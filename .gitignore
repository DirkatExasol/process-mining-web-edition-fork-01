.venv/
# Runtime state under data/ is ignored, EXCEPT the signed program license, which
# is shipped in-repo (time-bombed; refreshed with new files before it expires).
data/*
!data/license.json
node_modules/
dist/
__pycache__/
*.pyc
.DS_Store
*.tsbuildinfo
.pytest_cache/
.vitest/
.vite/
coverage/
"Background Images"

# Local assets (e.g. login-background source images) — never repo content
Background Images/

# Offline-manual build artifacts (regenerated by docs/manual/assemble.py).
# The published PDF is committed at docs/Process-Mining-Demonstrator-Manual.pdf.
docs/manual/manual.html
docs/manual/*.pdf
