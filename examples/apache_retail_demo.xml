<?xml version="1.0" encoding="UTF-8"?>
<!-- Small XML demo for the integration console's XML source type. Each <event> is one
     record; map @user_id → Id, step → Step, event_time → Timestamp, and status/method/path
     as Metas. Mirrors a handful of rows from apache_retail_demo.json / .log. -->
<events>
